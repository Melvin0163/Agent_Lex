# Copy this file to .env and adjust. .env is git-ignored: never commit keys.

# ---- Language model (writes the final answers) ----
LLM_PROVIDER=ollama            # ollama | groq | gemini | openrouter
OLLAMA_MODEL=qwen2.5:7b
# GROQ_API_KEY=...            GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=...          GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_LLM_MODEL=...

# ---- Decision model (Jev / System One API) ----
# Used for the reported results: Laya served locally by ollajev
#   ollajev serve convaiinnovations/laya-typed-decisions --no-browser
JEV_BACKEND=server             # server | typesafe | vercel | openrouter | local | auto
JEV_BASE_URL=http://127.0.0.1:8000
JEV_MODEL=convaiinnovations/laya-typed-decisions

# Hosted alternatives (same code, set JEV_BACKEND accordingly):
# TYPESAFE_API_KEY=...         # TypeSafe hosted Jev (access is waitlisted)
# AI_GATEWAY_API_KEY=...       # Vercel AI Gateway (model typesafe-ai/jev)
# OPENROUTER_API_KEY=...       # OpenRouter (model typesafe/jev-1.13)
# JEV_BACKEND=local            # offline stand-in from two small cross-encoders (interface only)
